{
  "name": "@api-workbench/workflow-mcp",
  "version": "0.1.0",
  "description": "MCP server for authoring API Workbench workflow JSON: schema resources, Ajv validation with self-correcting errors, and workflow generation.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "workflow-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepare": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.9",
    "zod-to-json-schema": "^3.25.2"
  }
}
