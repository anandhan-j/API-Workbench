  "rootId": "wf-tour",
  "workflows": [
    {
      "id": "wf-tour",
      "name": "Full feature tour",
      "description": "Exercises most workflow node kinds in canonical form: set-variable, request, transform, switch, loop, delay, user-input.",
      "graph": {
        "nodes": [
          {
            "id": "start",
            "kind": "start",
            "name": "Start",
            "position": {
              "x": 80,
              "y": 300
            },
            "config": {}
          },
          {
            "id": "seed",
            "kind": "set-variable",
            "name": "Seed base URL",
            "position": {
              "x": 300,
              "y": 300
            },
            "config": {
              "key": "baseUrl",
              "value": "https://httpbin.org",
              "scope": "runtime"
            }
          },
          {
            "id": "ask-plan",
            "kind": "user-input",
            "name": "Choose plan",
            "position": {
              "x": 520,
              "y": 300
            },
            "config": {
              "message": "Pick a plan to exercise.",
              "fields": [
                {
                  "kind": "select",
                  "label": "Plan",
                  "variable": "plan",
                  "default": "pro",
                  "options": [
                    "free",
                    "pro",
                    "enterprise"
                  ],
                  "entries": {},
                  "filledAtRuntime": false,
                  "required": true
                }
              ]
            }
          },
          {
            "id": "call",
            "kind": "request",
            "name": "Echo plan",
            "position": {
              "x": 740,
              "y": 300
            },
            "config": {
              "type": "http",
              "payload": {
                "method": "POST",
                "url": "{{baseUrl}}/post",
                "headers": {
                  "Content-Type": "application/json"
                },
                "query": {
                  "plan": "{{plan}}"
                },
                "body": {
                  "type": "json",
                  "content": "{\"plan\":\"{{plan}}\"}"
                }
              },
              "options": {
                "timeoutMs": 15000,
                "maxRetries": 1,
                "followRedirects": true
              },
              "extract": [
                {
                  "variable": "echoedPlan",
                  "source": "body",
                  "engine": "jsonpath",
                  "expression": "$.json.plan"
                }
              ]
            }
          },
